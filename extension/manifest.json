{
  "manifest_version": 2,
  "name": "Apply Kit",
  "version": "0.1.0",
  "description": "Fills job applications from a profile you keep. Syncs through Firefox Sync.",
  "browser_specific_settings": {
    "gecko": {
      "id": "apply-kit@personal.local",
      "strict_min_version": "115.0",
      "data_collection_permissions": { "required": ["none"] }
    },
    "gecko_android": { "strict_min_version": "120.0" }
  },
  "icons": { "48": "icon.svg", "96": "icon.svg" },
  "permissions": ["storage"],
  "browser_action": {
    "default_icon": "icon.svg",
    "default_title": "Apply Kit",
    "default_popup": "popup.html"
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "run_at": "document_idle",
      "js": ["rules.js", "storage.js", "content.js"]
    }
  ]
}
